{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_comment": "Azure Lighthouse delegation for Panopticon. Deployed at SUBSCRIPTION scope, and the access grant is now scoped to the whole subscription rather than a single resource group. RG scoping was tried first and failed silently: the customer names ONE resource group, and with the newer Microsoft.SentinelPlatformServices onboarding the Log Analytics workspace does NOT land in the same RG as the Sentinel resource, so the deployment reported Succeeded while the workspace stayed unreadable (403 InsufficientAccessError on api.loganalytics.io). Subscription scope removes that failure mode and covers workspaces the customer adds later. The grant is still read-only (Log Analytics Reader) — what widened is WHICH workspaces we can read, not what we can do to them. Contains no secrets."
  },
  "parameters": {
    "mspOfferName": {
      "type": "string",
      "defaultValue": "Panopticon SOC — Sentinel read access",
      "metadata": { "description": "Name shown to the customer for this delegation in their Service providers blade. The registration definition's id is derived from this name, so changing it creates a SEPARATE delegation rather than updating this one." }
    },
    "mspOfferDescription": {
      "type": "string",
      "defaultValue": "Grants the Panopticon security portal read-only access to this subscription's Microsoft Sentinel / Log Analytics data.",
      "metadata": { "description": "Description shown to the customer." }
    },
    "managedByTenantId": {
      "type": "string",
      "defaultValue": "770efa30-4160-4959-95ae-53298070a3a6",
      "metadata": { "description": "Evalian's (the managing/MSP) Entra tenant id." }
    },
    "authorizations": {
      "type": "array",
      "defaultValue": [
        {
          "principalId": "3ad07035-3ee4-4c4c-a8e8-0e5194150666",
          "roleDefinitionId": "73c42c96-874c-492b-b04d-ab87d138a893",
          "principalIdDisplayName": "Panopticon Sentinel Reader"
        }
      ],
      "metadata": { "description": "principalId = object id of the Sentinel service principal (delegating to the SP directly for now; switch to a security group later so principals rotate without a customer redeploy). roleDefinitionId = built-in Log Analytics Reader. Get the object id with: az ad sp show --id 59dccc26-2f9b-477c-a7b8-c7ed3f50a19d --query id -o tsv" }
    }
  },
  "variables": {
    "mspRegistrationName": "[guid(parameters('mspOfferName'))]",
    "mspAssignmentName": "[guid(parameters('mspOfferName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.ManagedServices/registrationDefinitions",
      "apiVersion": "2019-06-01",
      "name": "[variables('mspRegistrationName')]",
      "properties": {
        "registrationDefinitionName": "[parameters('mspOfferName')]",
        "description": "[parameters('mspOfferDescription')]",
        "managedByTenantId": "[parameters('managedByTenantId')]",
        "authorizations": "[parameters('authorizations')]"
      }
    },
    {
      "type": "Microsoft.ManagedServices/registrationAssignments",
      "apiVersion": "2019-06-01",
      "name": "[variables('mspAssignmentName')]",
      "dependsOn": [
        "[extensionResourceId(subscription().id, 'Microsoft.ManagedServices/registrationDefinitions', variables('mspRegistrationName'))]"
      ],
      "properties": {
        "registrationDefinitionId": "[extensionResourceId(subscription().id, 'Microsoft.ManagedServices/registrationDefinitions', variables('mspRegistrationName'))]"
      }
    }
  ],
  "outputs": {
    "mspOfferName": {
      "type": "string",
      "value": "[concat('Managed by ', parameters('mspOfferName'))]"
    },
    "authorizations": {
      "type": "array",
      "value": "[parameters('authorizations')]"
    }
  }
}
