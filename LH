{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_comment": "Azure Lighthouse delegation for Panopticon. Deployed at SUBSCRIPTION scope (registration definitions are only allowed at subscription scope); the access grant is scoped down to a single resource group via the nested deployment below. Grants Evalian's managing tenant read-only (Log Analytics Reader) access to the Sentinel / Log Analytics workspace in that resource group. Contains no secrets."
  },
  "parameters": {
    "mspOfferName": {
      "type": "string",
      "defaultValue": "Panopticon SOC — Sentinel read access",
      "metadata": { "description": "Name shown to the customer for this delegation in their Service providers blade." }
    },
    "mspOfferDescription": {
      "type": "string",
      "defaultValue": "Grants the Panopticon security portal read-only access to this workspace's Microsoft Sentinel / Log Analytics data.",
      "metadata": { "description": "Description shown to the customer." }
    },
    "managedByTenantId": {
      "type": "string",
      "defaultValue": "770efa30-4160-4959-95ae-53298070a3a6",
      "metadata": { "description": "Evalian's (the managing/MSP) Entra tenant id." }
    },
    "rgName": {
      "type": "string",
      "metadata": { "description": "Name of the resource group that contains the Microsoft Sentinel / Log Analytics workspace to delegate. The delegation is scoped to this RG only." }
    },
    "authorizations": {
      "type": "array",
      "defaultValue": [
        {
          "principalId": "3ad07035-3ee4-4c4c-a8e8-0e5194150666",
          "roleDefinitionId": "73c42c96-874c-492b-b04d-ab87d138a893",
          "principalIdDisplayName": "Panopticon Sentinel Reader"
        }
      ],
      "metadata": { "description": "principalId = object id of the Sentinel service principal (delegating to the SP directly for now; switch to a security group later so principals rotate without a customer redeploy). roleDefinitionId = built-in Log Analytics Reader. Get the object id with: az ad sp show --id 59dccc26-2f9b-477c-a7b8-c7ed3f50a19d --query id -o tsv" }
    }
  },
  "variables": {
    "mspRegistrationName": "[guid(parameters('mspOfferName'))]",
    "mspAssignmentName": "[guid(parameters('mspOfferName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.ManagedServices/registrationDefinitions",
      "apiVersion": "2019-06-01",
      "name": "[variables('mspRegistrationName')]",
      "properties": {
        "registrationDefinitionName": "[parameters('mspOfferName')]",
        "description": "[parameters('mspOfferDescription')]",
        "managedByTenantId": "[parameters('managedByTenantId')]",
        "authorizations": "[parameters('authorizations')]"
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2020-06-01",
      "name": "rgAssignment",
      "resourceGroup": "[parameters('rgName')]",
      "dependsOn": [
        "[resourceId('Microsoft.ManagedServices/registrationDefinitions', variables('mspRegistrationName'))]"
      ],
      "properties": {
        "mode": "Incremental",
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2018-05-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {},
          "resources": [
            {
              "type": "Microsoft.ManagedServices/registrationAssignments",
              "apiVersion": "2019-06-01",
              "name": "[variables('mspAssignmentName')]",
              "properties": {
                "registrationDefinitionId": "[extensionResourceId(subscription().id, 'Microsoft.ManagedServices/registrationDefinitions', variables('mspRegistrationName'))]"
              }
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "mspOfferName": {
      "type": "string",
      "value": "[concat('Managed by ', parameters('mspOfferName'))]"
    },
    "authorizations": {
      "type": "array",
      "value": "[parameters('authorizations')]"
    }
  }
}
